        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\"VACATION\", \"SICK_LEAVE\", \"OTHER\", \"UNCERTAIN\"]\n    },\n    \"provider\": {\n      \"type\": \"string\"\n    },\n    \"provider_message_id\": {\n      \"type\": \"string\"\n    },\n    \"from_email\": {\n      \"type\": \"string\"\n    },\n    \"to_email\": {\n      \"type\": \"string\"\n    },\n    \"subject\": {\n      \"type\": \"string\"\n    },\n    \"body_text\": {\n      \"type\": \"string\"\n    },\n    \"received_at\": {\n      \"type\": \"string\"\n    },\n    \"employee_email\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"employee_name\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"start_date\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"end_date\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\"new\", \"update\", \"cancel\", \"unknown\"]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"explanation\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"type\",\n    \"provider\",\n    \"provider_message_id\",\n    \"from_email\",\n    \"to_email\",\n    \"subject\",\n    \"body_text\",\n    \"received_at\",\n    \"employee_email\",\n    \"employee_name\",\n    \"start_date\",\n    \"end_date\",\n    \"intent\",\n    \"confidence\",\n    \"explanation\"\n  ],\n  \"additionalProperties\": false\n}"
